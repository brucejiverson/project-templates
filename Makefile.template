.PHONY: dev fix lint typecheck test clean

# Full validation: lint, typecheck, test
dev: lint typecheck test

# Auto-fix formatting and linting issues
fix:
	poetry run ruff format .
	poetry run ruff check --fix .

# Lint only
lint:
	poetry run ruff check .

# Type check only
typecheck:
	poetry run pyright

# Run tests with coverage
test:
	poetry run pytest --cov=project_name --cov-report=term-missing

# Clean up
clean:
	rm -rf .pytest_cache .ruff_cache .coverage htmlcov __pycache__
	find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
